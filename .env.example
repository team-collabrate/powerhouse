# Copy to .env.local and fill in. Every db:* script loads .env.local via dotenv-cli.

# --- Database (Supabase → Project Settings → Database → Connection string) ---
# DATABASE_URL: the "Transaction pooler" URI (port 6543). App runtime.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: the "Session pooler" / "Direct connection" URI (port 5432).
# Used by `prisma migrate` / `prisma studio`. Required.
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# --- Email (Sprint 4) ---
RESEND_API_KEY=""

# --- Optional: attach `npm run db:seed` output to your own account ---
# SEED_EMAIL="you@example.com"
